# Copia este archivo como .env (o ejecuta `npm run setup`, que lo genera con secretos aleatorios).

# --- PostgreSQL (lo usa docker-compose.yml) ---
POSTGRES_USER=sti
POSTGRES_PASSWORD=cambia_esta_clave
POSTGRES_DB=sti
POSTGRES_PORT=5433

# --- Servidor ---
DATABASE_URL=postgres://sti:cambia_esta_clave@localhost:5433/sti
JWT_SECRET=pon_aqui_una_cadena_larga_y_aleatoria
API_PORT=4000
ZONA_HORARIA=America/Caracas

# true = cualquier persona con acceso a la app puede registrarse como analista.
# false = solo se entra con cuentas ya existentes.
REGISTRO_ABIERTO=true

# Poner en true cuando la app se sirva por HTTPS (servidor de producción).
COOKIE_SECURE=false
